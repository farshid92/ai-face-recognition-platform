# Copy to .env and adjust. Every value is optional.

# Cosine similarity a face must reach to count as a registered person (-1 to 1).
MATCH_THRESHOLD=0.50

# InsightFace model pack baked into the API image (rebuild after changing).
INSIGHTFACE_MODEL=buffalo_l

# Port the web UI is published on: http://localhost:8080
FRONTEND_PORT=8080

# Comma-separated origins allowed to call the API directly from a browser.
# Leave empty when using the bundled frontend, which proxies through nginx.
CORS_ORIGINS=
